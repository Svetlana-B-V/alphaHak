# Скопируй этот файл в .env и поправь значения под себя

# Локальная разработка: SQLite (файл создастся сам рядом с проектом)
DATABASE_URL=sqlite:///./alphahak.db

# Для PostgreSQL раскомментируй и подставь свои данные:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/alphahak

# Адреса фронтенда через запятую (откуда разрешены запросы)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
